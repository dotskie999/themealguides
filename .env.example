# Supabase project URL from Project Settings > API.
SUPABASE_URL="https://your-project.supabase.co"

# Server-only Supabase secret key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_replace_me"

# Break-glass PIN used only for temporary emergency Super Admin access.
ADMIN_PIN="replace-with-a-private-pin"

# Generate a long, random value used to sign admin session cookies.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"

# Server-only key for Geoapify address search, reverse geocoding, and driving-route distance.
GEOAPIFY_API_KEY="replace-with-your-geoapify-key"

# Set both values to PH for order.themealguides.com and GH for gh.themealguides.com.
# The server value enforces data isolation; the public value configures the matching interface.
DEPLOYMENT_COUNTRY="PH"
NEXT_PUBLIC_DEPLOYMENT_COUNTRY="PH"
