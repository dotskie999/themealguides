# Supabase project URL from Project Settings > API.
SUPABASE_URL="https://your-project.supabase.co"

# Server-only Supabase secret key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY="sb_secret_replace_me"

# PIN used to sign in to the kitchen admin dashboard.
ADMIN_PIN="replace-with-a-private-pin"

# Generate a long, random value used to sign admin session cookies.
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret"
